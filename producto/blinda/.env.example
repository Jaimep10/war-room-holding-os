PORT=3000

# Supabase (opcional). Sin esto, BLINDA usa memoria con los mismos 20 números de prueba.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Cloud API (opcional). Sin esto, la alerta al hijo/a se imprime en consola.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Teléfono del hijo/a por defecto (E.164), si el body no trae userProfile.guardianPhone
GUARDIAN_PHONE=
