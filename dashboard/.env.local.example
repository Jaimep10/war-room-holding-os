# Copia este archivo a .env.local y completa tu clave para activar las respuestas en vivo de los agentes.
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: modelo a usar (por defecto claude-sonnet-4-5-20250929)
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Búsqueda real de mercado (tool buscarMercado en lib/tools.ts) — https://app.tavily.com
TAVILY_API_KEY=

# Gestión de hosting/WordPress (tool hostinger_api en lib/tools.ts, y lib/hostinger-client.ts
# + /api/hostinger/* para el botón "Conectar a Hostinger" del dashboard) — se genera en
# hPanel > API. Pegalo acá en tu Mac, nunca se lo mandes a Claude por el chat.
HOSTINGER_API_TOKEN=

# Para que /api/hostinger/deploy pueda crear contenido en el WordPress ya instalado necesita
# autenticarse contra ESE WordPress (no contra la API de Hostinger, son dos cosas separadas).
# Generá un Application Password (no tu password normal) en wp-admin > Usuarios > Tu perfil >
# "Application Passwords" del sitio de destino.
WP_ADMIN_USER=
WP_ADMIN_APP_PASSWORD=
